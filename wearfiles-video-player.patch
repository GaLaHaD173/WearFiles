diff --git a/mobile/src/main/java/com/dertefter/wearfiles/data/VideoConversion.kt b/mobile/src/main/java/com/dertefter/wearfiles/data/VideoConversion.kt
new file mode 100644
index 0000000..f2084cf
--- /dev/null
+++ b/mobile/src/main/java/com/dertefter/wearfiles/data/VideoConversion.kt
@@ -0,0 +1,209 @@
+package com.dertefter.wearfiles.data
+
+import android.content.Context
+import android.media.MediaCodecInfo
+import android.media.MediaExtractor
+import android.media.MediaFormat
+import android.net.Uri
+import android.util.Log
+import androidx.annotation.StringRes
+import androidx.media3.common.Effect
+import androidx.media3.common.MediaItem
+import androidx.media3.common.MimeTypes
+import androidx.media3.common.audio.AudioProcessor
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.effect.Presentation
+import androidx.media3.transformer.DefaultEncoderFactory
+import androidx.media3.transformer.EditedMediaItem
+import androidx.media3.transformer.EditedMediaItemSequence
+import androidx.media3.transformer.Effects
+import androidx.media3.transformer.ExportException
+import androidx.media3.transformer.ExportResult
+import androidx.media3.transformer.ProgressHolder
+import androidx.media3.transformer.Composition
+import androidx.media3.transformer.Transformer
+import androidx.media3.transformer.VideoEncoderSettings
+import com.dertefter.wearfiles.R
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.IOException
+import java.util.UUID
+
+/** How videos are prepared before they are sent to the watch. */
+enum class VideoPreset(
+    val prefValue: String,
+    val maxHeight: Int,
+    val videoBitrate: Int,
+    @StringRes val labelRes: Int,
+) {
+    ORIGINAL("original", 0, 0, R.string.convert_original),
+    P480("480p", 480, 800_000, R.string.convert_480),
+    P360("360p", 360, 450_000, R.string.convert_360),
+    P240("240p", 240, 250_000, R.string.convert_240);
+
+    companion object {
+        fun fromPref(value: String?): VideoPreset =
+            entries.firstOrNull { it.prefValue == value } ?: P480
+    }
+}
+
+object VideoPrefs {
+    private const val PREFS = "video_conversion"
+    private const val KEY_PRESET = "preset"
+
+    fun get(context: Context): VideoPreset =
+        VideoPreset.fromPref(
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY_PRESET, null)
+        )
+
+    fun set(context: Context, preset: VideoPreset) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putString(KEY_PRESET, preset.prefValue).apply()
+    }
+}
+
+/** What we found out about a video file. [outputHeight] is the height the converted file will have. */
+data class VideoAnalysis(val needsConversion: Boolean, val outputHeight: Int)
+
+@OptIn(UnstableApi::class)
+object VideoConverter {
+
+    private const val TAG = "VideoConverter"
+
+    private val WATCH_AUDIO_MIMES = setOf(MimeTypes.AUDIO_AAC, MimeTypes.AUDIO_MPEG, MimeTypes.AUDIO_OPUS)
+
+    /**
+     * Looks inside the file. Returns null if it is not a video (or cannot be read), so that the
+     * file is sent unchanged. A video needs conversion when its codec is not 8-bit H.264, it is
+     * taller than the chosen preset, or its audio is a format watches usually cannot decode.
+     */
+    fun analyze(context: Context, uri: Uri, preset: VideoPreset): VideoAnalysis? {
+        if (preset == VideoPreset.ORIGINAL) return null
+        val extractor = MediaExtractor()
+        try {
+            extractor.setDataSource(context, uri, null)
+            var videoMime: String? = null
+            var height = 0
+            var profile = -1
+            var audioMime: String? = null
+
+            for (i in 0 until extractor.trackCount) {
+                val format = extractor.getTrackFormat(i)
+                val mime = format.getString(MediaFormat.KEY_MIME) ?: continue
+                if (mime.startsWith("video/") && videoMime == null) {
+                    videoMime = mime
+                    if (format.containsKey(MediaFormat.KEY_HEIGHT)) height = format.getInteger(MediaFormat.KEY_HEIGHT)
+                    if (format.containsKey(MediaFormat.KEY_PROFILE)) profile = format.getInteger(MediaFormat.KEY_PROFILE)
+                } else if (mime.startsWith("audio/") && audioMime == null) {
+                    audioMime = mime
+                }
+            }
+
+            if (videoMime == null) return null // audio-only or unknown: send as is
+
+            val tenBitOrMore = profile == MediaCodecInfo.CodecProfileLevel.AVCProfileHigh10 ||
+                profile == MediaCodecInfo.CodecProfileLevel.AVCProfileHigh422 ||
+                profile == MediaCodecInfo.CodecProfileLevel.AVCProfileHigh444
+            val badVideo = videoMime != MimeTypes.VIDEO_H264 || tenBitOrMore
+            val tooTall = height > preset.maxHeight
+            val badAudio = audioMime != null && audioMime !in WATCH_AUDIO_MIMES
+
+            // Never upscale a small video
+            val outHeight = (if (height in 1 until preset.maxHeight) height else preset.maxHeight) and 1.inv()
+            Log.d(TAG, "analyze: video=$videoMime ${height}p profile=$profile audio=$audioMime -> convert=${badVideo || tooTall || badAudio}")
+            return VideoAnalysis(badVideo || tooTall || badAudio, outHeight)
+        } catch (e: Exception) {
+            Log.w(TAG, "analyze failed for $uri: ${e.message}")
+            return null
+        } finally {
+            extractor.release()
+        }
+    }
+
+    /** "Movie.mkv" -> "Movie.mp4". The base name stays the same so "Movie.srt" still matches. */
+    fun convertedName(originalName: String): String {
+        val base = originalName.substringBeforeLast('.', originalName).ifBlank { "video" }
+        return "$base.mp4"
+    }
+
+    /**
+     * Re-encodes the video to H.264 + AAC in an MP4 at the preset's size and bitrate.
+     * Returns the temporary output file, or null if cancelled. Throws on failure.
+     */
+    suspend fun convert(
+        context: Context,
+        uri: Uri,
+        preset: VideoPreset,
+        outputHeight: Int,
+        onProgress: (Int) -> Unit,
+        isCancelled: () -> Boolean,
+    ): File? {
+        val dir = File(context.cacheDir, "converted").apply { mkdirs() }
+        val output = File(dir, UUID.randomUUID().toString() + ".mp4")
+        val done = CompletableDeferred<Unit>()
+
+        // Transformer must be created, started and polled from one thread with a Looper.
+        return withContext(Dispatchers.Main) {
+            val encoderFactory = DefaultEncoderFactory.Builder(context)
+                .setRequestedVideoEncoderSettings(
+                    VideoEncoderSettings.Builder().setBitrate(preset.videoBitrate).build()
+                )
+                .build()
+
+            val transformer = Transformer.Builder(context)
+                .setVideoMimeType(MimeTypes.VIDEO_H264)
+                .setAudioMimeType(MimeTypes.AUDIO_AAC)
+                .setEncoderFactory(encoderFactory)
+                .addListener(object : Transformer.Listener {
+                    override fun onCompleted(composition: Composition, exportResult: ExportResult) {
+                        done.complete(Unit)
+                    }
+
+                    override fun onError(
+                        composition: Composition,
+                        exportResult: ExportResult,
+                        exportException: ExportException
+                    ) {
+                        done.completeExceptionally(IOException("Conversion failed: ${exportException.errorCodeName}", exportException))
+                    }
+                })
+                .build()
+
+            val videoEffects = mutableListOf<Effect>()
+            if (outputHeight > 0) videoEffects += Presentation.createForHeight(outputHeight)
+            val edited = EditedMediaItem.Builder(MediaItem.fromUri(uri))
+                .setEffects(Effects(emptyList<AudioProcessor>(), videoEffects))
+                .build()
+
+            // HDR sources are tone-mapped to SDR, because the H.264 encoder cannot write HDR.
+            val composition = Composition.Builder(EditedMediaItemSequence.Builder(edited).build())
+                .setHdrMode(Composition.HDR_MODE_TONE_MAP_HDR_TO_SDR_USING_OPEN_GL)
+                .build()
+
+            try {
+                transformer.start(composition, output.absolutePath)
+                val holder = ProgressHolder()
+                while (!done.isCompleted) {
+                    if (isCancelled()) {
+                        transformer.cancel()
+                        output.delete()
+                        return@withContext null
+                    }
+                    if (transformer.getProgress(holder) == Transformer.PROGRESS_STATE_AVAILABLE) {
+                        onProgress(holder.progress)
+                    }
+                    delay(400)
+                }
+                done.await()
+                output
+            } catch (e: Exception) {
+                transformer.cancel()
+                output.delete()
+                throw e
+            }
+        }
+    }
+}

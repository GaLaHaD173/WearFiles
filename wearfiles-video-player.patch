+
+/**
+ * Built-in video player for the watch. Plays MKV / WebM / MP4 etc. with Media3 ExoPlayer,
+ * so we no longer depend on a system app that can open the file.
+ *
+ * Launch with an explicit intent: data = video uri, optional EXTRA_PATH = absolute file path
+ * (used to find sidecar subtitle files like "Movie.srt" next to "Movie.mkv").
+ */
+@OptIn(UnstableApi::class)
+class VideoPlayerActivity : ComponentActivity() {
+
+    private var player: ExoPlayer? = null
+    private lateinit var playerView: PlayerView
+    private lateinit var overlay: FrameLayout
+    private lateinit var playPauseButton: ImageView
+    private lateinit var seekBar: SeekBar
+    private lateinit var timeText: TextView
+    private lateinit var statusText: TextView
+    private lateinit var infoText: TextView
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var userSeeking = false
+    private var firstFrameRendered = false
+    private var hasVideoTrack = false
+    private var lastInfo = ""
+
+    private val hideOverlayRunnable = Runnable { overlay.visibility = View.GONE }
+    private val hideInfoRunnable = Runnable { infoText.visibility = View.GONE }
+    private val progressRunnable = object : Runnable {
+        override fun run() {
+            updateProgress()
+            handler.postDelayed(this, 500)
+        }
+    }
+    private val firstFrameCheck = Runnable {
+        if (hasVideoTrack && !firstFrameRendered) {
+            showStatus(getString(R.string.video_no_frames, lastInfo))
+        }
+    }
+
+    private var videoUri: Uri? = null
+    private var videoPath: String? = null
+    private var sourceKey: String = ""
+    private var codecWarningShown = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        val uri = intent?.data
+        if (uri == null) {
+            finish()
+            return
+        }
+        videoUri = uri
+        videoPath = intent.getStringExtra(EXTRA_PATH)
+        sourceKey = videoPath ?: uri.toString()
+
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        setContentView(buildLayout())
+    }
+
+    override fun onStart() {
+        super.onStart()
+        if (videoUri != null) initPlayer()
+    }
+
+    override fun onStop() {
+        super.onStop()
+        savePosition()
+        releasePlayer()
+    }
+
+    // ---------------------------------------------------------------- UI
+
+    private fun buildLayout(): View {
+        val match = ViewGroup.LayoutParams.MATCH_PARENT
+        val wrap = ViewGroup.LayoutParams.WRAP_CONTENT
+
+        val root = FrameLayout(this).apply {
+            setBackgroundColor(Color.BLACK)
+            layoutParams = ViewGroup.LayoutParams(match, match)
+        }
+
+        // The video itself. We draw our own controls, sized for a small round screen.
+        playerView = PlayerView(this).apply {
+            useController = false
+            resizeMode = AspectRatioFrameLayout.RESIZE_MODE_FIT
+            subtitleView?.setFractionalTextSize(0.065f)
+        }
+        root.addView(playerView, FrameLayout.LayoutParams(match, match))
+
+        // Invisible layer: tap anywhere to show / hide the controls
+        val tapLayer = View(this).apply { setOnClickListener { toggleOverlay() } }
+        root.addView(tapLayer, FrameLayout.LayoutParams(match, match))
+
+        overlay = FrameLayout(this).apply { visibility = View.GONE }
+        val scrim = View(this).apply {
+            setBackgroundColor(0x99000000.toInt())
+            setOnClickListener { overlay.visibility = View.GONE }
+        }
+        overlay.addView(scrim, FrameLayout.LayoutParams(match, match))
+
+        val ccButton = makeButton("CC", 34, 12f) { cycleSubtitles() }
+        val audioButton = makeButton("\u266A", 34, 14f) { cycleAudio() }
+        val backButton = makeButton("-10", 40, 12f) { seekBy(-10_000) }
+        val forwardButton = makeButton("+10", 40, 12f) { seekBy(10_000) }
+
+        playPauseButton = ImageView(this).apply {
+            setImageResource(android.R.drawable.ic_media_pause)
+            scaleType = ImageView.ScaleType.CENTER_INSIDE
+            setPadding(dp(12), dp(12), dp(12), dp(12))
+            background = circleBackground()
+            layoutParams = LinearLayout.LayoutParams(dp(54), dp(54)).apply {
+                marginStart = dp(5)
+                marginEnd = dp(5)
+            }
+            setOnClickListener {
+                togglePlay()
+                scheduleHide()
+            }
+        }
+
+        seekBar = SeekBar(this).apply {
+            max = 1000
+            setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
+                override fun onProgressChanged(sb: SeekBar?, progress: Int, fromUser: Boolean) {
+                    if (fromUser) {
+                        val d = player?.duration ?: C.TIME_UNSET
+                        if (d != C.TIME_UNSET && d > 0) {
+                            timeText.text = formatTime(d * progress / 1000) + " / " + formatTime(d)
+                        }
+                    }
+                }
+
+                override fun onStartTrackingTouch(sb: SeekBar?) {
+                    userSeeking = true
+                    handler.removeCallbacks(hideOverlayRunnable)
+                }
+
+                override fun onStopTrackingTouch(sb: SeekBar?) {
+                    userSeeking = false
+                    val p = player
+                    val d = p?.duration ?: C.TIME_UNSET
+                    if (p != null && d != C.TIME_UNSET && d > 0) {
+                        p.seekTo(d * (sb?.progress ?: 0) / 1000)
+                    }
+                    scheduleHide()
+                }
+            })
+        }
+
+        timeText = TextView(this).apply {
+            setTextColor(Color.WHITE)
+            textSize = 10f
+            gravity = Gravity.CENTER
+            text = "0:00"
+        }
+
+        val column = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.CENTER_HORIZONTAL
+        }
+        column.addView(row(ccButton, audioButton))
+        column.addView(
+            row(backButton, playPauseButton, forwardButton),
+            LinearLayout.LayoutParams(wrap, wrap).apply { topMargin = dp(6) }
+        )
+        column.addView(
+            seekBar,
+            LinearLayout.LayoutParams(dp(120), dp(28)).apply { topMargin = dp(4) }
+        )
+        column.addView(timeText, LinearLayout.LayoutParams(wrap, wrap))
+        overlay.addView(column, FrameLayout.LayoutParams(wrap, wrap, Gravity.CENTER))
+        root.addView(overlay, FrameLayout.LayoutParams(match, match))
+
+        // Small codec info line, shown for a few seconds when the video opens
+        infoText = TextView(this).apply {
+            setTextColor(0xFFBBBBBB.toInt())
+            textSize = 9f
+            gravity = Gravity.CENTER
+            maxLines = 4
+            maxWidth = dp(130)
+            visibility = View.GONE
+        }
+        root.addView(
+            infoText,
+            FrameLayout.LayoutParams(wrap, wrap, Gravity.TOP or Gravity.CENTER_HORIZONTAL)
+                .apply { topMargin = dp(22) }
+        )
+
+        statusText = TextView(this).apply {
+            setTextColor(Color.WHITE)
+            textSize = 12f
+            gravity = Gravity.CENTER
+            setPadding(dp(32), dp(20), dp(32), dp(20))
+            visibility = View.GONE
+        }
+        root.addView(statusText, FrameLayout.LayoutParams(match, wrap, Gravity.CENTER))
+
+        return root
+    }
+
+    private fun row(vararg views: View): LinearLayout =
+        LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER
+            views.forEach { addView(it) }
+        }
+
+    private fun circleBackground() = GradientDrawable().apply {
+        shape = GradientDrawable.OVAL
+        setColor(0xB3000000.toInt())
+        setStroke(dp(1), 0x66FFFFFF)
+    }
+
+    private fun makeButton(label: String, sizeDp: Int, textSp: Float, onClick: () -> Unit): TextView =
+        TextView(this).apply {
+            text = label
+            setTextColor(Color.WHITE)
+            textSize = textSp
+            gravity = Gravity.CENTER
+            background = circleBackground()
+            layoutParams = LinearLayout.LayoutParams(dp(sizeDp), dp(sizeDp)).apply {
+                marginStart = dp(5)
+                marginEnd = dp(5)
+            }
+            setOnClickListener {
+                onClick()
+                scheduleHide()
+            }
+        }
+
+    private fun dp(value: Int): Int = (value * resources.displayMetrics.density).toInt()
+
+    private fun showStatus(message: String) {
+        statusText.text = message
+        statusText.visibility = View.VISIBLE
+    }
+
+    private fun toggleOverlay() {
+        if (overlay.visibility == View.VISIBLE) {
+            handler.removeCallbacks(hideOverlayRunnable)
+            overlay.visibility = View.GONE
+        } else {
+            overlay.visibility = View.VISIBLE
+            updateProgress()
+            scheduleHide()
+        }
+    }
+
+    private fun scheduleHide() {
+        handler.removeCallbacks(hideOverlayRunnable)
+        if (player?.isPlaying == true && !userSeeking) {
+            handler.postDelayed(hideOverlayRunnable, 4000)
+        }
+    }
+
+    private fun togglePlay() {
+        val p = player ?: return
+        if (p.isPlaying) {
+            p.pause()
+        } else {
+            if (p.playbackState == Player.STATE_ENDED) p.seekTo(0)
+            p.play()
+        }
+    }
+
+    private fun seekBy(deltaMs: Long) {
+        val p = player ?: return
+        val duration = p.duration
+        var target = (p.currentPosition + deltaMs).coerceAtLeast(0L)
+        if (duration != C.TIME_UNSET) target = target.coerceAtMost(duration)
+        p.seekTo(target)
+    }
+
+    private fun updateProgress() {
+        val p = player ?: return
+        if (userSeeking) return
+        val duration = p.duration
+        val position = p.currentPosition
+        if (duration != C.TIME_UNSET && duration > 0) {
+            seekBar.isEnabled = true
+            seekBar.progress = (position * 1000 / duration).toInt().coerceIn(0, 1000)
+            timeText.text = formatTime(position) + " / " + formatTime(duration)
+        } else {
+            seekBar.isEnabled = false
+            timeText.text = formatTime(position)
+        }
+    }
+
+    private fun formatTime(ms: Long): String {
+        val totalSeconds = (if (ms < 0) 0L else ms) / 1000
+        val h = totalSeconds / 3600
+        val m = (totalSeconds % 3600) / 60
+        val sec = totalSeconds % 60
+        return if (h > 0) String.format(Locale.US, "%d:%02d:%02d", h, m, sec)
+        else String.format(Locale.US, "%d:%02d", m, sec)
+    }
+
+    // ---------------------------------------------------------------- Player
+
+    private fun initPlayer() {
+        if (player != null) return
+        val uri = videoUri ?: return
+
+        firstFrameRendered = false
+        hasVideoTrack = false
+
+        val renderersFactory = DefaultRenderersFactory(this)
+            .setEnableDecoderFallback(true)
+
+        val exo = ExoPlayer.Builder(this, renderersFactory)
+            .setHandleAudioBecomingNoisy(true)
+            .build()
+        player = exo
+        playerView.player = exo
+
+        val item = MediaItem.Builder()
+            .setUri(uri)
+            .setSubtitleConfigurations(findSidecarSubtitles(videoPath))
+            .build()
+
+        exo.addListener(object : Player.Listener {
+            override fun onTracksChanged(tracks: Tracks) {
+                hasVideoTrack = tracks.groups.any { it.type == C.TRACK_TYPE_VIDEO }
+                lastInfo = describeTracks(tracks)
+                infoText.text = lastInfo
+                infoText.visibility = View.VISIBLE
+                handler.removeCallbacks(hideInfoRunnable)
+                handler.postDelayed(hideInfoRunnable, 8000)
+                checkForUnsupportedTracks(tracks)
+            }
+
+            override fun onRenderedFirstFrame() {
+                firstFrameRendered = true
+                handler.removeCallbacks(firstFrameCheck)
+                statusText.visibility = View.GONE
+            }
+
+            override fun onIsPlayingChanged(isPlaying: Boolean) {
+                playPauseButton.setImageResource(
+                    if (isPlaying) android.R.drawable.ic_media_pause
+                    else android.R.drawable.ic_media_play
+                )
+            }
+
+            override fun onPlayerError(error: PlaybackException) {
+                val cause = error.cause?.message?.take(120)
+                val detail = if (cause.isNullOrBlank()) error.errorCodeName
+                else error.errorCodeName + "\n" + cause
+                showStatus(getString(R.string.video_error_generic, detail))
+            }
+
+            override fun onPlaybackStateChanged(playbackState: Int) {
+                if (playbackState == Player.STATE_READY) {
+                    if (!firstFrameRendered) {
+                        handler.removeCallbacks(firstFrameCheck)
+                        handler.postDelayed(firstFrameCheck, 4000)
+                    }
+                } else if (playbackState == Player.STATE_ENDED) {
+                    overlay.visibility = View.VISIBLE
+                }
+            }
+        })
+
+        val start = restorePosition()
+        if (start > 0) {
+            exo.setMediaItem(item, start)
+        } else {
+            exo.setMediaItem(item)
+        }
+        exo.playWhenReady = true
+        exo.prepare()
+        handler.post(progressRunnable)
+    }
+
+    private fun releasePlayer() {
+        handler.removeCallbacksAndMessages(null)
+        player?.release()
+        player = null
+        if (::playerView.isInitialized) playerView.player = null
+    }
+
+    /** Short codec summary, e.g. "V hevc 1920x1080 hvc1.2.4.L120 NO" (NO = watch cannot decode it). */
+    private fun describeTracks(tracks: Tracks): String {
+        val lines = mutableListOf<String>()
+        tracks.groups.firstOrNull { it.type == C.TRACK_TYPE_VIDEO }?.let { g ->
+            val f = g.getTrackFormat(0)
+            val size = if (f.width > 0) " ${f.width}x${f.height}" else ""
+            val codecs = f.codecs?.let { " $it" } ?: ""
+            lines += "V ${shortMime(f.sampleMimeType)}$size$codecs ${if (g.isSupported()) "ok" else "NO"}"
+        }
+        tracks.groups.firstOrNull { it.type == C.TRACK_TYPE_AUDIO }?.let { g ->
+            val f = g.getTrackFormat(0)
+            lines += "A ${shortMime(f.sampleMimeType)} ${if (g.isSupported()) "ok" else "NO"}"
+        }
+        val subtitleCount = tracks.groups.count { it.type == C.TRACK_TYPE_TEXT }
+        if (subtitleCount > 0) lines += "CC x$subtitleCount"
+        return lines.joinToString("\n")
+    }
+
+    private fun shortMime(mime: String?): String = mime?.substringAfter('/') ?: "?"
+
+    /**
+     * If the file has a video (or audio) track but this watch has no decoder for it, tell the user
+     * exactly what is wrong instead of showing a black screen.
+     */
+    private fun checkForUnsupportedTracks(tracks: Tracks) {
+        if (codecWarningShown) return
+
+        val videoGroups = tracks.groups.filter { it.type == C.TRACK_TYPE_VIDEO }
+        val audioGroups = tracks.groups.filter { it.type == C.TRACK_TYPE_AUDIO }
+
+        if (videoGroups.isNotEmpty() && videoGroups.none { it.isSupported() }) {
+            codecWarningShown = true
+            val mime = videoGroups.first().getTrackFormat(0).sampleMimeType ?: "?"
+            showStatus(getString(R.string.video_unsupported_video, mime))
+        } else if (audioGroups.isNotEmpty() && audioGroups.none { it.isSupported() }) {
+            codecWarningShown = true
+            val mime = audioGroups.first().getTrackFormat(0).sampleMimeType ?: "?"
+            Toast.makeText(
+                this,
+                getString(R.string.video_unsupported_audio, mime),
+                Toast.LENGTH_LONG
+            ).show()
+        }
+    }
+
+    // ---------------------------------------------------------------- Subtitles / audio
+
+    private fun cycleSubtitles() {
+        val p = player ?: return
+        val groups = p.currentTracks.groups.filter { it.type == C.TRACK_TYPE_TEXT && it.isSupported() }
+        if (groups.isEmpty()) {
+            Toast.makeText(this, R.string.video_subtitles_none, Toast.LENGTH_SHORT).show()
+            return
+        }
+
+        // -1 (none selected) -> 0 -> 1 ... -> last -> off
+        val currentIndex = groups.indexOfFirst { it.isSelected() }
+        val nextIndex = currentIndex + 1
+        val params = p.trackSelectionParameters.buildUpon()
+
+        if (nextIndex >= groups.size) {
+            params.setTrackTypeDisabled(C.TRACK_TYPE_TEXT, true)
+            Toast.makeText(this, R.string.video_subtitles_off, Toast.LENGTH_SHORT).show()
+        } else {
+            val group = groups[nextIndex]
+            params.setTrackTypeDisabled(C.TRACK_TYPE_TEXT, false)
+            params.setOverrideForType(TrackSelectionOverride(group.mediaTrackGroup, 0))
+            Toast.makeText(
+                this,
+                "CC: " + trackName(group.getTrackFormat(0), nextIndex),
+                Toast.LENGTH_SHORT
+            ).show()
+        }
+        p.trackSelectionParameters = params.build()
+    }
+
+    private fun cycleAudio() {
+        val p = player ?: return
+        val groups = p.currentTracks.groups.filter { it.type == C.TRACK_TYPE_AUDIO && it.isSupported() }
+        if (groups.size < 2) return
+
+        val currentIndex = groups.indexOfFirst { it.isSelected() }
+        val nextIndex = (currentIndex + 1) % groups.size
+        val group = groups[nextIndex]
+
+        p.trackSelectionParameters = p.trackSelectionParameters.buildUpon()
+            .setOverrideForType(TrackSelectionOverride(group.mediaTrackGroup, 0))
+            .build()
+
+        Toast.makeText(
+            this,
+            getString(R.string.video_audio_track, trackName(group.getTrackFormat(0), nextIndex)),
+            Toast.LENGTH_SHORT
+        ).show()
+    }
+
+    private fun trackName(format: Format, index: Int): String {
+        format.label?.takeIf { it.isNotBlank() }?.let { return it }
+        format.language?.takeIf { it.isNotBlank() && it != "und" }?.let {
+            val name = Locale.forLanguageTag(it).displayLanguage
+            if (name.isNotBlank()) return name
+        }
+        return getString(R.string.video_track_default, index + 1)
+    }
+
+    /** Finds "Movie.srt", "Movie.en.srt", "Movie.vtt", "Movie.ass" next to "Movie.mkv". */
+    private fun findSidecarSubtitles(path: String?): List<MediaItem.SubtitleConfiguration> {
+        if (path.isNullOrEmpty()) return emptyList()
+        val video = File(path)
+        val dir = video.parentFile ?: return emptyList()
+        val base = video.nameWithoutExtension
+
+        val files = try {
+            dir.listFiles()
+        } catch (_: SecurityException) {
+            null
+        } ?: return emptyList()
+
+        return files
+            .filter { it.isFile && it.name.startsWith(base, ignoreCase = true) && it.extension.lowercase() in SUBTITLE_EXTENSIONS }
+            .sortedBy { it.name }
+            .mapIndexed { index, file ->
+                val ext = file.extension.lowercase()
+                val mime = when (ext) {
+                    "srt" -> MimeTypes.APPLICATION_SUBRIP
+                    "vtt" -> MimeTypes.TEXT_VTT
+                    else -> MimeTypes.TEXT_SSA
+                }
+                val label = file.nameWithoutExtension
+                    .removePrefix(base)
+                    .trim('.', '_', '-', ' ')
+                    .ifEmpty { ext.uppercase() }
+                MediaItem.SubtitleConfiguration.Builder(Uri.fromFile(file))
+                    .setMimeType(mime)
+                    .setLabel(label)
+                    .setSelectionFlags(if (index == 0) C.SELECTION_FLAG_DEFAULT else 0)
+                    .build()
+            }
+    }
+
+    // ---------------------------------------------------------------- Resume position
+
+    private fun savePosition() {
+        val p = player ?: return
+        val prefs = getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val duration = p.duration
+        val position = p.currentPosition
+        if (duration != C.TIME_UNSET && position > 5_000 && position < duration - 10_000) {
+            prefs.edit().putLong(sourceKey, position).apply()
+        } else {
+            prefs.edit().remove(sourceKey).apply()
+        }
+    }
+
+    private fun restorePosition(): Long =
+        getSharedPreferences(PREFS, Context.MODE_PRIVATE).getLong(sourceKey, 0L)
+
+    companion object {
+        const val EXTRA_PATH = "com.dertefter.wearfiles.extra.VIDEO_PATH"
+        private const val PREFS = "video_positions"
+        private val SUBTITLE_EXTENSIONS = setOf("srt", "vtt", "ass", "ssa")
+    }
+}

diff --git a/mobile/src/main/java/com/dertefter/wearfiles/data/MkvSubtitleExtractor.kt b/mobile/src/main/java/com/dertefter/wearfiles/data/MkvSubtitleExtractor.kt
new file mode 100644
index 0000000..aafe803
--- /dev/null
+++ b/mobile/src/main/java/com/dertefter/wearfiles/data/MkvSubtitleExtractor.kt
@@ -0,0 +1,350 @@
+package com.dertefter.wearfiles.data
+
+import android.content.Context
+import android.net.Uri
+import android.util.Log
+import java.io.File
+import java.io.FileInputStream
+import java.nio.ByteBuffer
+import java.nio.channels.FileChannel
+import java.util.Locale
+
+/**
+ * Pulls the text subtitle tracks (SubRip, ASS/SSA) out of a Matroska (.mkv / .webm) file and
+ * writes each one as a standalone .srt file. A converted video is an MP4, which cannot carry these
+ * tracks, so they are sent to the watch next to the movie (same base name) and the watch player
+ * picks them up and lets you switch them on and off.
+ *
+ * Only a small part of the EBML structure is read; video and audio data are skipped, never decoded.
+ */
+object MkvSubtitleExtractor {
+
+    private const val TAG = "MkvSubtitleExtractor"
+
+    private const val ID_EBML = 0x1A45DFA3L
+    private const val ID_SEGMENT = 0x18538067L
+    private const val ID_INFO = 0x1549A966L
+    private const val ID_TIMECODE_SCALE = 0x2AD7B1L
+    private const val ID_TRACKS = 0x1654AE6BL
+    private const val ID_TRACK_ENTRY = 0xAEL
+    private const val ID_TRACK_NUMBER = 0xD7L
+    private const val ID_TRACK_TYPE = 0x83L
+    private const val ID_CODEC_ID = 0x86L
+    private const val ID_LANGUAGE = 0x22B59CL
+    private const val ID_NAME = 0x536EL
+    private const val ID_CLUSTER = 0x1F43B675L
+    private const val ID_CLUSTER_TIMECODE = 0xE7L
+    private const val ID_SIMPLE_BLOCK = 0xA3L
+    private const val ID_BLOCK_GROUP = 0xA0L
+    private const val ID_BLOCK = 0xA1L
+    private const val ID_BLOCK_DURATION = 0x9BL
+
+    private const val TRACK_TYPE_SUBTITLE = 17L
+    private const val DEFAULT_CUE_MS = 3000L
+    private const val MAX_CUE_BYTES = 64 * 1024L
+
+    private class Header(val id: Long, val headerLen: Int, val size: Long)
+
+    private class TrackBuilder {
+        var number = -1L
+        var type = -1L
+        var codec = ""
+        var language = ""
+        var name = ""
+    }
+
+    private class SubTrack(val number: Long, val codec: String, val language: String, val name: String) {
+        val cues = ArrayList<Cue>()
+    }
+
+    private class Cue(val startMs: Long, val endMs: Long, val text: String)
+
+    private class Pending(val track: SubTrack, val startMs: Long, val text: String)
+
+    /** Reads bytes at absolute positions with a small cache, so skipping over blocks stays cheap. */
+    private class Reader(private val channel: FileChannel) {
+        val size: Long = channel.size()
+        private val buf = ByteBuffer.allocate(512)
+        private var bufStart = -1L
+        private var bufLen = 0
+
+        fun byteAt(pos: Long): Int {
+            if (pos < 0 || pos >= size) return -1
+            if (bufStart < 0 || pos < bufStart || pos >= bufStart + bufLen) {
+                buf.clear()
+                val n = channel.read(buf, pos)
+                bufStart = pos
+                bufLen = if (n < 0) 0 else n
+            }
+            if (bufLen <= 0) return -1
+            return buf.get((pos - bufStart).toInt()).toInt() and 0xFF
+        }
+
+        fun readBytes(pos: Long, length: Int): ByteArray {
+            val b = ByteBuffer.allocate(length)
+            var p = pos
+            while (b.hasRemaining()) {
+                val n = channel.read(b, p)
+                if (n < 0) break
+                p += n
+            }
+            return b.array().copyOf(b.position())
+        }
+
+        fun readHeader(pos: Long): Header? {
+            val b0 = byteAt(pos)
+            if (b0 <= 0) return null
+            val idLen = (b0.countLeadingZeroBits() - 24) + 1
+            if (idLen > 4) return null
+            var id = b0.toLong()
+            for (i in 1 until idLen) {
+                val b = byteAt(pos + i)
+                if (b < 0) return null
+                id = (id shl 8) or b.toLong()
+            }
+            val s0 = byteAt(pos + idLen)
+            if (s0 <= 0) return null
+            val sizeLen = (s0.countLeadingZeroBits() - 24) + 1
+            val mask = 0xFF shr sizeLen
+            var value = (s0 and mask).toLong()
+            var allOnes = (s0 and mask) == mask
+            for (i in 1 until sizeLen) {
+                val b = byteAt(pos + idLen + i)
+                if (b < 0) return null
+                value = (value shl 8) or b.toLong()
+                if (b != 0xFF) allOnes = false
+            }
+            return Header(id, idLen + sizeLen, if (allOnes) -1L else value)
+        }
+
+        fun readUInt(pos: Long, length: Long): Long {
+            var v = 0L
+            for (i in 0 until minOf(length, 8L).toInt()) {
+                val b = byteAt(pos + i)
+                if (b < 0) break
+                v = (v shl 8) or b.toLong()
+            }
+            return v
+        }
+
+        fun readString(pos: Long, length: Long): String =
+            String(readBytes(pos, minOf(length, 256L).toInt()), Charsets.UTF_8).trimEnd('\u0000')
+    }
+
+    /**
+     * Extracts every readable text subtitle track into "<baseName>.<language>.srt" files in [outDir].
+     * Returns the files written (empty if the file is not Matroska or has no text subtitles).
+     */
+    fun extract(context: Context, uri: Uri, baseName: String, outDir: File): List<File> {
+        return try {
+            context.contentResolver.openFileDescriptor(uri, "r")?.use { pfd ->
+                FileInputStream(pfd.fileDescriptor).use { stream ->
+                    parse(Reader(stream.channel))
+                }
+            }?.let { tracks -> writeFiles(tracks, baseName, outDir) } ?: emptyList()
+        } catch (e: Exception) {
+            Log.w(TAG, "Subtitle extraction failed for $uri: ${e.message}")
+            emptyList()
+        }
+    }
+
+    private fun parse(reader: Reader): List<SubTrack> {
+        val first = reader.readHeader(0) ?: return emptyList()
+        if (first.id != ID_EBML || first.size < 0) return emptyList()
+
+        var pos = first.headerLen + first.size
+        var timecodeScale = 1_000_000L
+        var clusterTime = 0L
+        var current: TrackBuilder? = null
+        val wanted = HashMap<Long, SubTrack>()
+        val all = ArrayList<SubTrack>()
+        var pending: Pending? = null
+        var groupDuration = -1L
+
+        fun commitEntry() {
+            val t = current ?: return
+            current = null
+            val supported = t.codec == "S_TEXT/UTF8" || t.codec == "S_TEXT/ASS" || t.codec == "S_TEXT/SSA"
+            if (t.type == TRACK_TYPE_SUBTITLE && supported && t.number >= 0) {
+                val track = SubTrack(t.number, t.codec, t.language, t.name)
+                wanted[t.number] = track
+                all += track
+            }
+        }
+
+        fun flushPending(durationMs: Long) {
+            val p = pending ?: return
+            pending = null
+            val d = if (durationMs > 0) durationMs else DEFAULT_CUE_MS
+            p.track.cues += Cue(p.startMs, p.startMs + d, p.text)
+        }
+
+        while (pos < reader.size) {
+            val h = reader.readHeader(pos) ?: break
+            val dataPos = pos + h.headerLen
+
+            when (h.id) {
+                ID_SEGMENT, ID_INFO, ID_TRACKS -> pos = dataPos
+
+                ID_TRACK_ENTRY -> {
+                    commitEntry()
+                    current = TrackBuilder()
+                    pos = dataPos
+                }
+
+                ID_CLUSTER -> {
+                    commitEntry()
+                    flushPending(-1)
+                    pos = dataPos
+                }
+
+                ID_BLOCK_GROUP -> {
+                    flushPending(-1)
+                    groupDuration = -1L
+                    pos = dataPos
+                }
+
+                ID_TIMECODE_SCALE -> {
+                    timecodeScale = reader.readUInt(dataPos, h.size).coerceAtLeast(1L)
+                    pos = dataPos + h.size
+                }
+
+                ID_TRACK_NUMBER -> {
+                    current?.number = reader.readUInt(dataPos, h.size)
+                    pos = dataPos + h.size
+                }
+
+                ID_TRACK_TYPE -> {
+                    current?.type = reader.readUInt(dataPos, h.size)
+                    pos = dataPos + h.size
+                }
+
+                ID_CODEC_ID -> {
+                    current?.codec = reader.readString(dataPos, h.size)
+                    pos = dataPos + h.size
+                }
+
+                ID_LANGUAGE -> {
+                    current?.language = reader.readString(dataPos, h.size)
+                    pos = dataPos + h.size
+                }
+
+                ID_NAME -> {
+                    current?.name = reader.readString(dataPos, h.size)
+                    pos = dataPos + h.size
+                }
+
+                ID_CLUSTER_TIMECODE -> {
+                    clusterTime = reader.readUInt(dataPos, h.size)
+                    pos = dataPos + h.size
+                }
+
+                ID_BLOCK_DURATION -> {
+                    val ms = reader.readUInt(dataPos, h.size) * timecodeScale / 1_000_000L
+                    if (pending != null) flushPending(ms) else groupDuration = ms
+                    pos = dataPos + h.size
+                }
+
+                ID_SIMPLE_BLOCK, ID_BLOCK -> {
+                    if (h.size < 0) break
+                    if (h.id == ID_SIMPLE_BLOCK) flushPending(-1)
+                    commitEntry()
+
+                    // Block header: track number (variable length), 16-bit relative time, flags
+                    val b0 = reader.byteAt(dataPos)
+                    val trackLen = if (b0 > 0) (b0.countLeadingZeroBits() - 24) + 1 else 0
+                    val track = if (trackLen in 1..2) {
+                        var n = (b0 and (0xFF shr trackLen)).toLong()
+                        if (trackLen == 2) n = (n shl 8) or reader.byteAt(dataPos + 1).toLong()
+                        wanted[n]
+                    } else null
+
+                    if (track != null && h.size > trackLen + 3 && h.size <= MAX_CUE_BYTES) {
+                        val hi = reader.byteAt(dataPos + trackLen)
+                        val lo = reader.byteAt(dataPos + trackLen + 1)
+                        val flags = reader.byteAt(dataPos + trackLen + 2)
+                        val laced = ((flags shr 1) and 3) != 0
+                        if (hi >= 0 && lo >= 0 && flags >= 0 && !laced) {
+                            val rel = ((hi shl 8) or lo).toShort().toInt()
+                            val startMs = (clusterTime + rel) * timecodeScale / 1_000_000L
+                            val raw = reader.readBytes(dataPos + trackLen + 3, (h.size - trackLen - 3).toInt())
+                            val text = cueText(track.codec, raw)
+                            if (text != null) {
+                                pending = Pending(track, startMs, text)
+                                if (groupDuration >= 0) {
+                                    flushPending(groupDuration)
+                                    groupDuration = -1L
+                                } else if (h.id == ID_SIMPLE_BLOCK) {
+                                    flushPending(-1)
+                                }
+                            }
+                        }
+                    }
+                    pos = dataPos + h.size
+                }
+
+                else -> {
+                    if (h.size < 0) break // unknown-size element we do not understand
+                    pos = dataPos + h.size
+                }
+            }
+        }
+        commitEntry()
+        flushPending(-1)
+        return all.filter { it.cues.isNotEmpty() }
+    }
+
+    private fun cueText(codec: String, raw: ByteArray): String? {
+        val text = String(raw, Charsets.UTF_8)
+        val cleaned = if (codec == "S_TEXT/UTF8") {
+            text
+        } else {
+            // ASS/SSA block: ReadOrder,Layer,Style,Name,MarginL,MarginR,MarginV,Effect,Text
+            val parts = text.split(",", limit = 9)
+            if (parts.size < 9) return null
+            parts[8]
+                .replace(Regex("\\{[^}]*\\}"), "")
+                .replace("\\N", "\n")
+                .replace("\\n", "\n")
+                .replace("\\h", " ")
+        }
+        return cleaned.replace("\r", "").replace(Regex("\n{2,}"), "\n").trim().ifEmpty { null }
+    }
+
+    private fun writeFiles(tracks: List<SubTrack>, baseName: String, outDir: File): List<File> {
+        outDir.mkdirs()
+        val used = HashSet<String>()
+        val files = ArrayList<File>()
+        for ((index, track) in tracks.withIndex()) {
+            var suffix = track.language.takeIf { it.isNotBlank() && it != "und" }
+                ?: track.name.takeIf { it.isNotBlank() }
+                ?: "sub${index + 1}"
+            suffix = suffix.replace(Regex("[^A-Za-z0-9_-]"), "").ifEmpty { "sub${index + 1}" }
+            var unique = suffix
+            var n = 2
+            while (!used.add(unique)) unique = "$suffix-${n++}"
+
+            val file = File(outDir, "$baseName.$unique.srt")
+            val sorted = track.cues.sortedBy { it.startMs }
+            file.bufferedWriter(Charsets.UTF_8).use { w ->
+                sorted.forEachIndexed { i, cue ->
+                    w.write("${i + 1}\n")
+                    w.write("${formatTime(cue.startMs)} --> ${formatTime(cue.endMs)}\n")
+                    w.write(cue.text)
+                    w.write("\n\n")
+                }
+            }
+            Log.d(TAG, "Wrote ${file.name}: ${sorted.size} cues")
+            files += file
+        }
+        return files
+    }
+
+    private fun formatTime(ms: Long): String {
+        val t = if (ms < 0) 0L else ms
+        return String.format(
+            Locale.US, "%02d:%02d:%02d,%03d",
+            t / 3_600_000, (t / 60_000) % 60, (t / 1000) % 60, t % 1000
+        )
+    }
+}
